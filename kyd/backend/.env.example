# Copy this file to .env (same folder) and edit the copy. Never commit .env or put real passwords in this file.
KYD_DATA_MODE=sqlite             # sqlite (bundled real data) | fixture (synthetic) | live (Postgres / Supabase)
KYD_DATABASE_URL=postgresql://kyd:kyd_dev@127.0.0.1:5433/kyd   # live mode. Supabase: the Session pooler string
KYD_NEO4J_URI=bolt://127.0.0.1:7688
KYD_NEO4J_PASSWORD=kyd_dev_pw
KYD_GRAPH_MODE=auto              # auto (Neo4j if running, else in-memory) | neo4j | fixture
KYD_LLM_PROVIDER=none            # none | anthropic | openai (any OpenAI-compatible, incl. local llama.cpp/vLLM)
KYD_LLM_MODEL=
KYD_LLM_BASE_URL=                # e.g. http://127.0.0.1:8080/v1 for a local server
KYD_LLM_API_KEY=
KYD_AUTH_SECRET=                 # long random string (empty = random per process); service tokens: python -m app.auth --sub NAME --role ROLE
KYD_AUTH_REQUIRED=true           # sign-in required for the app and API (except /api/health and /api/auth/*)
KYD_OWNER_EMAIL=                 # this account is the owner; empty = the first account registered
KYD_GOOGLE_CLIENT_ID=            # "Continue with Google": OAuth web client ID; empty = button hidden
KYD_SMTP_HOST=                   # forgot-password codes by email; empty = reset by email is off
KYD_SMTP_PORT=587                # 465 = implicit TLS, otherwise STARTTLS
KYD_SMTP_USER=
KYD_SMTP_PASSWORD=
KYD_SMTP_FROM=                   # e.g. KYD <admin@dataworkflows.ai>; empty = KYD_SMTP_USER
KYD_TRUST_PROXY_HEADERS=false    # true ONLY behind an SSO proxy that strips client-sent x-kyd-* headers
